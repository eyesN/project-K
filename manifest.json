{
  "manifest_version": 3,
  "name": "Project K - Toxicity Filter",
  "version": "1.0",
  "description": "Filters toxic comments using TensorFlow.js and Natural.js",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}